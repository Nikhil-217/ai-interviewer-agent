# -----------------------------------------------------------------------------
# AI Interview Agent - Environment Configuration Example
# -----------------------------------------------------------------------------

# [REQUIRED] Your OpenAI API Key (or key for your compatible provider)
OPENAI_API_KEY=your_openai_api_key_here

# [OPTIONAL] Swappable Base URL for OpenAI-compatible APIs:
# - DeepSeek: https://api.deepseek.com/v1
# - Local Ollama: http://localhost:11434/v1
# - Local LM Studio: http://localhost:1234/v1
# Leave blank to default to standard OpenAI completions.
# OPENAI_BASE_URL=

# [OPTIONAL] Swappable Model Identifier:
# - Default: gpt-4o-mini
# - DeepSeek: deepseek-chat
# - Ollama: llama3.1
# OPENAI_MODEL_NAME=gpt-4o-mini
